/* ================= ROOT ================= */

:root {
    --brown: #7b4b2a;
    --dark: #241710;
    --cream: #f8f4ee;
    --light: #fffaf4;
    --text: #62584f;
    --border: #e8ddd2;
    --white: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    color: var(--dark);
    background: var(--white);
    line-height: 1.6;
}

img {
    width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
textarea {
    font: inherit;
}

.container {
    width: min(1150px, 92%);
    margin: auto;
}

.section {
    padding: 100px 0;
}


/* ================= NAVBAR ================= */

.navbar {
    background: rgba(255,255,255,.96);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-content {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo {
    font-family: "Playfair Display", serif;
    font-size: 25px;
    font-weight: 700;
    color: var(--dark);
}

.logo i {
    color: var(--brown);
    margin-right: 5px;
}

.logo span,
h1 span,
h2 span {
    color: var(--brown);
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    font-size: 14px;
    font-weight: 600;
    color: #514940;
    transition: .3s;
}

nav a:hover {
    color: var(--brown);
}

.nav-btn {
    background: var(--brown);
    color: white;
    padding: 11px 19px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
}


/* ================= HERO ================= */

.hero {
    background: var(--cream);
    padding: 85px 0;
    overflow: hidden;
}

.hero-content {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: center;
    gap: 70px;
}

.tag,
.section-label {
    color: var(--brown);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}

.tag {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    background: #eee2d6;
    padding: 9px 14px;
    border-radius: 50px;
}

h1,
h2 {
    font-family: "Playfair Display", serif;
    line-height: 1.15;
}

h1 {
    font-size: clamp(45px, 5vw, 72px);
    margin: 22px 0;
}

.hero-text > p {
    color: var(--text);
    max-width: 560px;
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    gap: 14px;
    margin: 32px 0;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 22px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
    border: none;
    cursor: pointer;
}

.primary {
    background: var(--brown);
    color: white;
}

.secondary {
    border: 1px solid var(--brown);
    color: var(--brown);
    background: transparent;
}

.hero-info {
    display: flex;
    gap: 40px;
    padding-top: 15px;
}

.hero-info strong {
    display: block;
    font-size: 21px;
}

.hero-info small {
    color: var(--text);
}

.hero-image {
    position: relative;
}

.image-card {
    height: 520px;
    overflow: hidden;
    border-radius: 180px 180px 10px 10px;
    box-shadow: 0 20px 60px rgba(52, 35, 22, .18);
}

.image-card img {
    height: 100%;
    object-fit: cover;
}

.floating-card {
    position: absolute;
    left: -35px;
    bottom: 35px;
    background: white;
    padding: 15px 20px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 15px 35px rgba(0,0,0,.12);
}

.floating-card i {
    color: #e5a62b;
    font-size: 25px;
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card small {
    color: var(--text);
}


/* ================= FEATURES ================= */

.features {
    padding: 35px 0;
    border-bottom: 1px solid var(--border);
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 40px;
}

.feature {
    display: flex;
    gap: 15px;
    align-items: center;
}

.feature-icon {
    width: 50px;
    height: 50px;
    background: #f1e5d9;
    color: var(--brown);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 20px;
}

.feature h3 {
    font-size: 16px;
}

.feature p {
    font-size: 13px;
    color: var(--text);
}


/* ================= ABOUT ================= */

.about {
    background: white;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: center;
}

.about-images {
    position: relative;
    padding-right: 50px;
}

.about-main {
    height: 530px;
    object-fit: cover;
    border-radius: 10px;
}

.experience {
    position: absolute;
    right: 0;
    bottom: 35px;
    background: var(--brown);
    color: white;
    padding: 22px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.experience strong {
    font-family: "Playfair Display";
    font-size: 38px;
}

.experience span {
    font-size: 12px;
}

h2 {
    font-size: 45px;
    margin: 15px 0 22px;
}

.about-content > p {
    color: var(--text);
    margin-bottom: 15px;
}

.about-list {
    margin: 25px 0;
}

.about-list div {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 11px 0;
}

.about-list i {
    color: var(--brown);
}


/* ================= MENU ================= */

.menu {
    background: var(--cream);
}

.section-heading {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 50px;
}

.section-heading h2 {
    margin-bottom: 10px;
}

.section-heading p {
    color: var(--text);
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
}

.coffee-card {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: .3s;
}

.coffee-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 15px 35px rgba(48,31,19,.12);
}

.coffee-image {
    height: 230px;
    position: relative;
    overflow: hidden;
}

.coffee-image img {
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.coffee-card:hover img {
    transform: scale(1.06);
}

.badge {
    position: absolute;
    top: 13px;
    left: 13px;
    background: var(--brown);
    color: white;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

.coffee-info {
    padding: 20px;
}

.coffee-title {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.coffee-title h3 {
    font-family: "Playfair Display";
    font-size: 20px;
}

.coffee-title strong {
    color: var(--brown);
}

.coffee-info p {
    color: var(--text);
    font-size: 13px;
    margin: 8px 0 15px;
}

.coffee-info button {
    width: 100%;
    padding: 10px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--brown);
    border-radius: 5px;
    cursor: pointer;
    font-weight: 600;
}

.coffee-info button:hover {
    background: var(--brown);
    color: white;
}

.menu-button {
    text-align: center;
    margin-top: 40px;
}


/* ================= OFFER ================= */

.offer {
    background: var(--dark);
    color: white;
    padding: 70px 0;
}

.offer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.offer h2 {
    max-width: 600px;
}

.offer p {
    color: #cfc2b7;
    max-width: 600px;
    margin-bottom: 25px;
}

.offer-icon {
    width: 150px;
    height: 150px;
    border: 1px solid #75543e;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 60px;
    color: #d4a77d;
}

.light {
    background: white;
    color: var(--brown);
}


/* ================= REVIEWS ================= */

.review-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
}

.review {
    border: 1px solid var(--border);
    padding: 30px;
    border-radius: 10px;
}

.stars {
    color: #e4a72c;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

.review > p {
    color: var(--text);
    font-size: 14px;
    margin-bottom: 25px;
}

.customer {
    display: flex;
    gap: 12px;
    align-items: center;
}

.avatar {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: #eadbce;
    color: var(--brown);
    border-radius: 50%;
    font-weight: 700;
}

.customer strong,
.customer small {
    display: block;
}

.customer small {
    color: var(--text);
    font-size: 11px;
}


/* ================= NEWSLETTER ================= */

.newsletter {
    background: var(--cream);
    padding: 60px 0;
}

.newsletter-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 50px;
}

.newsletter h2 {
    font-size: 35px;
    margin: 8px 0 0;
}

.newsletter form {
    display: flex;
    min-width: 430px;
}

.newsletter input {
    flex: 1;
    padding: 14px;
    border: 1px solid var(--border);
    outline: none;
}

.newsletter button {
    border: none;
    padding: 0 22px;
    background: var(--brown);
    color: white;
    font-weight: 600;
}


/* ================= CONTACT ================= */

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
}

.contact > .container > div > p {
    color: var(--text);
}

.contact-item {
    display: flex;
    gap: 15px;
    margin-top: 25px;
}

.contact-item > i {
    color: var(--brown);
    font-size: 20px;
    margin-top: 4px;
}

.contact-item p {
    color: var(--text);
    font-size: 13px;
}

.contact-box {
    background: var(--cream);
    padding: 35px;
    border-radius: 10px;
}

.contact-box h3 {
    font-family: "Playfair Display";
    font-size: 25px;
    margin-bottom: 20px;
}

.contact-box input,
.contact-box textarea {
    width: 100%;
    border: 1px solid var(--border);
    padding: 13px;
    margin-bottom: 12px;
    background: white;
    outline: none;
    resize: vertical;
}

.contact-box input:focus,
.contact-box textarea:focus {
    border-color: var(--brown);
}


/* ================= FOOTER ================= */

footer {
    background: #1b120d;
    color: white;
    padding-top: 65px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 70px;
    padding-bottom: 50px;
}

footer .logo {
    color: white;
}

footer p {
    color: #b8aaa0;
    font-size: 13px;
    margin-top: 15px;
    max-width: 350px;
}

footer h4 {
    margin-bottom: 15px;
}

.footer-grid > div:nth-child(2) a {
    display: block;
    color: #b8aaa0;
    font-size: 13px;
    margin: 8px 0;
}

.socials {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.socials a {
    width: 35px;
    height: 35px;
    border: 1px solid #55443a;
    display: grid;
    place-items: center;
    border-radius: 50%;
}

.socials a:hover {
    background: var(--brown);
}

.copyright {
    border-top: 1px solid #33251e;
    text-align: center;
    padding: 20px;
    color: #88786d;
    font-size: 12px;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 900px) {

    nav {
        display: none;
    }

    .hero-content,
    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .hero-image {
        max-width: 600px;
        margin: auto;
    }

    .menu-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .feature-grid,
    .review-grid {
        grid-template-columns: 1fr;
    }

    .newsletter-content,
    .offer-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .newsletter form {
        width: 100%;
        min-width: 0;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}


@media (max-width: 600px) {

    .section {
        padding: 70px 0;
    }

    .nav-btn {
        display: none;
    }

    h1 {
        font-size: 43px;
    }

    h2 {
        font-size: 35px;
    }

    .hero {
        padding: 60px 0;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .hero-info {
        gap: 20px;
        flex-wrap: wrap;
    }

    .image-card {
        height: 400px;
    }

    .floating-card {
        left: 10px;
    }

    .about-images {
        padding-right: 20px;
    }

    .about-main {
        height: 400px;
    }

    .menu-grid {
        grid-template-columns: 1fr;
    }

    .newsletter h2 {
        font-size: 30px;
    }

    .newsletter form {
        flex-direction: column;
        gap: 10px;
    }

    .newsletter input,
    .newsletter button {
        min-height: 48px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }
}
