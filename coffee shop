<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Brew & Bean - Premium coffee shop serving freshly roasted coffee and delicious desserts.">

    <title>Brew & Bean | Premium Coffee Shop</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <!-- =====================================================
         CSS
    ====================================================== -->

    <style>

        /* ================= RESET ================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "DM Sans", sans-serif;
            background: #fffaf5;
            color: #2c211c;
            line-height: 1.6;
        }

        img {
            width: 100%;
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }


        /* ================= VARIABLES ================= */

        :root {
            --brown: #3a2419;
            --brown-light: #6f4a37;
            --orange: #b86b3c;
            --orange-dark: #97552f;
            --cream: #fffaf5;
            --cream-dark: #f3e9df;
            --white: #ffffff;
            --text-light: #796c64;
            --border: #e8ddd3;
        }


        /* ================= COMMON ================= */

        .section {
            padding: 100px 7%;
        }

        .section-label {
            color: var(--orange);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 3px;
            margin-bottom: 14px;
        }

        .section-heading {
            text-align: center;
            max-width: 650px;
            margin: 0 auto 50px;
        }

        .section-heading h2,
        .about-content h2,
        .contact-info h2 {
            font-family: "Playfair Display", serif;
            font-size: clamp(38px, 5vw, 58px);
            line-height: 1.15;
            margin-bottom: 18px;
        }

        .section-heading h2 em,
        .about-content h2 em,
        .contact-info h2 em,
        .hero h1 em,
        .offer h2 em,
        .newsletter h2 em {
            color: var(--orange);
            font-style: italic;
        }

        .section-heading p:last-child,
        .about-content > p,
        .contact-info > p {
            color: var(--text-light);
        }


        /* ================= NAVBAR ================= */

        .header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;

            background: rgba(255, 250, 245, 0.95);
            backdrop-filter: blur(15px);

            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .navbar {
            max-width: 1400px;
            height: 82px;
            padding: 0 7%;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-family: "Playfair Display", serif;
            font-size: 26px;
            font-weight: 700;

            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo > span:not(.logo-icon) {
            color: var(--orange);
        }

        .logo-icon {
            width: 40px;
            height: 40px;

            display: grid;
            place-items: center;

            background: var(--brown);
            color: white;

            border-radius: 50%;
            font-size: 17px;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 35px;
            list-style: none;
        }

        .nav-menu a {
            color: #594a42;
            font-size: 14px;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-menu a:hover,
        .nav-menu a.active {
            color: var(--orange);
        }

        .nav-button {
            background: var(--brown);
            color: white;

            padding: 12px 20px;
            border-radius: 30px;

            font-size: 13px;
            font-weight: 600;

            display: flex;
            gap: 10px;
            align-items: center;

            transition: 0.3s;
        }

        .nav-button:hover {
            background: var(--orange);
            transform: translateY(-2px);
        }

        .menu-toggle {
            display: none;

            background: none;
            border: none;

            font-size: 24px;
            color: var(--brown);
        }


        /* ================= HERO ================= */

        .hero {
            min-height: 760px;

            display: flex;
            align-items: center;

            background:
                linear-gradient(
                    90deg,
                    rgba(32, 20, 14, 0.93),
                    rgba(32, 20, 14, 0.65),
                    rgba(32, 20, 14, 0.25)
                ),
                url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1800&q=85");

            background-size: cover;
            background-position: center;

            color: white;
        }

        .hero-container {
            width: 100%;
            max-width: 1400px;

            padding: 120px 7% 80px;
            margin: auto;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .hero-content {
            max-width: 700px;
        }

        .hero-label {
            display: flex;
            align-items: center;
            gap: 12px;

            color: #e5b99a;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 3px;

            margin-bottom: 25px;
        }

        .hero-label span {
            width: 35px;
            height: 1px;
            background: #e5b99a;
        }

        .hero h1 {
            font-family: "Playfair Display", serif;

            font-size: clamp(52px, 7vw, 88px);

            line-height: 1.02;

            margin-bottom: 28px;
        }

        .hero h1 em {
            display: block;
        }

        .hero-content > p {
            max-width: 570px;

            color: #e5d8cf;

            font-size: 17px;

            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
        }


        /* ================= BUTTONS ================= */

        .btn {
            padding: 14px 24px;

            border-radius: 30px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            gap: 12px;

            border: none;

            font-size: 14px;
            font-weight: 700;

            transition: 0.3s;
        }

        .btn-primary {
            background: var(--orange);
            color: white;
        }

        .btn-primary:hover {
            background: var(--orange-dark);
            transform: translateY(-3px);
        }

        .btn-outline {
            border: 1px solid rgba(255,255,255,0.5);
            color: white;
        }

        .btn-outline:hover {
            background: white;
            color: var(--brown);
        }

        .btn-dark {
            background: var(--brown);
            color: white;
        }

        .btn-dark:hover {
            background: var(--orange);
        }

        .btn-light {
            background: white;
            color: var(--brown);
        }

        .btn-light:hover {
            transform: translateY(-3px);
        }


        /* ================= HERO RATING ================= */

        .hero-rating {
            margin-top: 45px;

            display: flex;
            align-items: center;
            gap: 15px;
        }

        .avatars {
            display: flex;
        }

        .avatars span {
            width: 38px;
            height: 38px;

            border-radius: 50%;

            display: grid;
            place-items: center;

            background: var(--orange);

            border: 2px solid white;

            margin-left: -8px;

            font-size: 12px;
            font-weight: bold;
        }

        .avatars span:first-child {
            margin-left: 0;
        }

        .stars {
            color: #f5b642;
            font-size: 13px;
        }

        .hero-rating p {
            font-size: 12px;
            color: #d6c8c0;
        }

        .hero-rating strong {
            color: white;
        }


        /* ================= HERO CARD ================= */

        .hero-card {
            width: 330px;
        }

        .floating-card {
            background: rgba(255,255,255,0.96);
            color: var(--brown);

            padding: 20px;

            border-radius: 18px;

            display: flex;
            align-items: center;
            gap: 15px;

            box-shadow: 0 25px 70px rgba(0,0,0,0.3);

            animation: floating 3s ease-in-out infinite;
        }

        @keyframes floating {

            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-12px);
            }

        }

        .coffee-icon {
            width: 58px;
            height: 58px;

            background: #f2e2d4;

            color: var(--orange);

            display: grid;
            place-items: center;

            border-radius: 14px;

            font-size: 24px;
        }

        .floating-card small {
            color: var(--text-light);
        }

        .floating-card h3 {
            font-family: "Playfair Display", serif;
            font-size: 17px;
        }

        .floating-card p {
            color: var(--orange);
            font-weight: 700;
        }

        .floating-card button {
            margin-left: auto;

            width: 38px;
            height: 38px;

            border: none;
            border-radius: 50%;

            background: var(--brown);
            color: white;
        }


        /* ================= FEATURES ================= */

        .features {
            background: white;
            border-bottom: 1px solid var(--border);
        }

        .feature-container {
            max-width: 1300px;
            margin: auto;
            padding: 32px 7%;

            display: grid;
            grid-template-columns: repeat(4, 1fr);

            gap: 25px;
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .feature-icon {
            width: 52px;
            height: 52px;

            flex-shrink: 0;

            background: #f5e8dc;
            color: var(--orange);

            border-radius: 50%;

            display: grid;
            place-items: center;

            font-size: 19px;
        }

        .feature h3 {
            font-size: 14px;
            margin-bottom: 3px;
        }

        .feature p {
            font-size: 12px;
            color: var(--text-light);
        }


        /* ================= ABOUT ================= */

        .about {
            max-width: 1400px;
            margin: auto;

            display: grid;
            grid-template-columns: 1fr 1fr;

            gap: 100px;

            align-items: center;
        }

        .about-image {
            position: relative;
        }

        .about-image img {
            height: 580px;
            object-fit: cover;

            border-radius: 20px;
        }

        .experience-card {
            position: absolute;

            right: -30px;
            bottom: 35px;

            width: 180px;
            height: 180px;

            border-radius: 50%;

            background: var(--orange);
            color: white;

            display: flex;
            flex-direction: column;

            align-items: center;
            justify-content: center;

            box-shadow: 0 20px 50px rgba(90,40,15,0.25);
        }

        .experience-card strong {
            font-family: "Playfair Display", serif;
            font-size: 48px;
            line-height: 1;
        }

        .experience-card span {
            color: white;
            text-align: center;
            font-size: 12px;
            margin-top: 8px;
        }

        .about-content > p {
            margin-bottom: 18px;
            max-width: 580px;
        }

        .about-stats {
            display: flex;
            gap: 45px;

            margin: 35px 0;
        }

        .about-stats div {
            display: flex;
            flex-direction: column;
        }

        .about-stats strong {
            font-family: "Playfair Display", serif;
            font-size: 28px;
            color: var(--brown);
        }

        .about-stats span {
            color: var(--text-light);
            font-size: 12px;
        }

        .text-link {
            color: var(--orange);
            font-size: 14px;
            font-weight: 700;

            display: inline-flex;
            align-items: center;
            gap: 10px;
        }


        /* ================= MENU ================= */

        .menu {
            background: #f7efe8;
        }

        .menu-filter {
            display: flex;
            justify-content: center;
            gap: 10px;

            margin-bottom: 45px;

            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 10px 20px;

            border: 1px solid var(--border);

            background: white;

            color: var(--text-light);

            border-radius: 30px;

            font-size: 13px;

            transition: 0.3s;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--brown);
            color: white;
            border-color: var(--brown);
        }

        .menu-grid {
            max-width: 1250px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);

            gap: 25px;
        }

        .product-card {
            background: white;

            border-radius: 16px;

            overflow: hidden;

            box-shadow: 0 8px 30px rgba(60,40,20,0.06);

            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-8px);

            box-shadow:
                0 20px 45px rgba(60,40,20,0.12);
        }

        .product-image {
            height: 260px;
            position: relative;
            overflow: hidden;
        }

        .product-image img {
            height: 100%;
            object-fit: cover;

            transition: 0.5s;
        }

        .product-card:hover .product-image img {
            transform: scale(1.06);
        }

        .product-badge {
            position: absolute;
            z-index: 2;

            top: 15px;
            left: 15px;

            padding: 6px 12px;

            border-radius: 20px;

            background: var(--orange);
            color: white;

            font-size: 10px;
            font-weight: 700;
        }

        .product-badge.new {
            background: var(--brown);
        }

        .favorite {
            position: absolute;
            right: 15px;
            top: 15px;

            width: 40px;
            height: 40px;

            border: none;

            background: white;
            color: var(--brown);

            border-radius: 50%;

            font-size: 16px;
        }

        .product-info {
            padding: 22px;
        }

        .product-rating {
            color: #e9a83b;
            font-size: 12px;
            margin-bottom: 8px;
        }

        .product-rating span {
            color: #a39992;
            margin-left: 4px;
        }

        .product-info h3 {
            font-family: "Playfair Display", serif;
            font-size: 22px;
            margin-bottom: 7px;
        }

        .product-info p {
            color: var(--text-light);
            font-size: 13px;
            min-height: 42px;
        }

        .product-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-top: 18px;
        }

        .product-bottom strong {
            font-family: "Playfair Display", serif;
            font-size: 22px;
        }

        .add-cart {
            border: none;

            background: #f3e6db;
            color: var(--orange);

            padding: 9px 15px;

            border-radius: 8px;

            font-weight: 700;

            transition: 0.3s;
        }

        .add-cart:hover {
            background: var(--orange);
            color: white;
        }

        .menu-button {
            text-align: center;
            margin-top: 50px;
        }


        /* ================= OFFER ================= */

        .offer {
            min-height: 470px;

            background: var(--brown);
            color: white;

            display: grid;
            grid-template-columns: 1fr 1fr;

            overflow: hidden;
        }

        .offer-content {
            padding: 80px 12%;

            display: flex;
            flex-direction: column;
            justify-content: center;

            align-items: flex-start;
        }

        .offer-small {
            color: #d7a47e;
            font-size: 11px;
            letter-spacing: 3px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .offer h2 {
            font-family: "Playfair Display", serif;
            font-size: clamp(40px, 5vw, 60px);
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .offer p {
            color: #cbbdb4;
            margin-bottom: 28px;
        }

        .offer-image {
            height: 100%;
        }

        .offer-image img {
            height: 100%;
            object-fit: cover;
        }


        /* ================= REVIEWS ================= */

        .review-grid {
            max-width: 1200px;
            margin: auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);

            gap: 25px;
        }

        .review-card {
            position: relative;

            background: white;

            border: 1px solid var(--border);

            border-radius: 16px;

            padding: 35px;

            transition: 0.3s;
        }

        .review-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(50,30,15,0.08);
        }

        .quote {
            position: absolute;

            top: 15px;
            right: 25px;

            font-family: Georgia, serif;

            font-size: 70px;

            color: #f2e6dc;
        }

        .review-stars {
            color: #e9a83b;

            font-size: 14px;

            margin-bottom: 18px;
        }

        .review-card > p {
            color: var(--text-light);

            font-size: 14px;

            line-height: 1.8;

            margin-bottom: 28px;
        }

        .customer {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .customer-avatar {
            width: 45px;
            height: 45px;

            display: grid;
            place-items: center;

            border-radius: 50%;

            background: #f0dfd2;
            color: var(--orange);

            font-weight: 700;
        }

        .customer strong,
        .customer span {
            display: block;
        }

        .customer strong {
            font-size: 13px;
        }

        .customer span {
            color: #998c84;
            font-size: 11px;
        }


        /* ================= NEWSLETTER ================= */

        .newsletter {
            background: #f3e5d9;

            padding: 65px 7%;

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 40px;
        }

        .newsletter > div > span {
            color: var(--orange);
            font-size: 11px;
            letter-spacing: 3px;
            font-weight: 700;
        }

        .newsletter h2 {
            font-family: "Playfair Display", serif;

            font-size: 35px;

            line-height: 1.2;

            margin-top: 8px;
        }

        .newsletter-form {
            max-width: 470px;
            width: 100%;

            background: white;

            border-radius: 50px;

            padding: 5px;

            display: flex;
        }

        .newsletter-form input {
            flex: 1;

            border: none;

            outline: none;

            padding: 12px 18px;

            background: transparent;

            min-width: 0;
        }

        .newsletter-form button {
            border: none;

            background: var(--brown);
            color: white;

            padding: 12px 20px;

            border-radius: 30px;

            font-weight: 600;
        }


        /* ================= CONTACT ================= */

        .contact {
            max-width: 1400px;
            margin: auto;

            display: grid;

            grid-template-columns: 0.9fr 1.1fr;

            gap: 100px;

            align-items: center;
        }

        .contact-info > p {
            max-width: 500px;

            margin-bottom: 35px;
        }

        .contact-item {
            display: flex;
            align-items: center;

            gap: 15px;

            margin-bottom: 20px;
        }

        .contact-item > div {
            width: 45px;
            height: 45px;

            border-radius: 50%;

            background: #f3e5d9;

            color: var(--orange);

            display: grid;
            place-items: center;
        }

        .contact-item span {
            display: flex;
            flex-direction: column;

            font-size: 13px;

            color: var(--text-light);
        }

        .contact-item strong {
            color: var(--brown);
        }

        .contact-form-wrapper {
            background: #f5ebe3;

            border-radius: 20px;

            padding: 45px;
        }

        .contact-form h3 {
            font-family: "Playfair Display", serif;

            font-size: 28px;

            margin-bottom: 25px;
        }

        .form-row {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 15px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;

            border: 1px solid var(--border);

            background: white;

            outline: none;

            border-radius: 8px;

            padding: 14px;

            margin-bottom: 15px;

            resize: vertical;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: var(--orange);
        }


        /* ================= FOOTER ================= */

        .footer {
            background: #241710;

            color: white;

            padding: 75px 7% 25px;
        }

        .footer-container {
            max-width: 1300px;

            margin: auto;

            display: grid;

            grid-template-columns: 1.5fr 1fr 1fr 1fr;

            gap: 60px;
        }

        .footer-brand p {
            color: #a99b92;

            font-size: 13px;

            max-width: 280px;

            margin: 20px 0;
        }

        .footer .logo {
            color: white;
        }

        .social-links {
            display: flex;
            gap: 10px;
        }

        .social-links a {
            width: 38px;
            height: 38px;

            border-radius: 50%;

            display: grid;
            place-items: center;

            background: #38261d;

            color: #c8b9b0;

            transition: 0.3s;
        }

        .social-links a:hover {
            background: var(--orange);
            color: white;
        }

        .footer-column {
            display: flex;
            flex-direction: column;
            gap: 11px;
        }

        .footer-column h4 {
            margin-bottom: 8px;
        }

        .footer-column a,
        .footer-column p {
            color: #a99b92;
            font-size: 13px;
        }

        .footer-column a:hover {
            color: white;
        }

        .footer-column strong {
            color: white;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .footer-bottom {
            max-width: 1300px;

            margin: 60px auto 0;

            padding-top: 22px;

            border-top: 1px solid #44342b;

            display: flex;

            justify-content: space-between;

            color: #82736a;

            font-size: 11px;
        }

        .footer-bottom span {
            color: var(--orange);
        }


        /* ================= RESPONSIVE ================= */

        @media (max-width: 1050px) {

            .nav-menu {
                gap: 20px;
            }

            .hero-card {
                display: none;
            }

            .about {
                gap: 50px;
            }

            .feature-container {
                grid-template-columns: repeat(2, 1fr);
            }

            .menu-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .review-grid {
                grid-template-columns: 1fr 1fr;
            }

            .review-card:last-child {
                grid-column: span 2;
            }

            .footer-container {
                grid-template-columns: repeat(2, 1fr);
            }

        }


        @media (max-width: 768px) {

